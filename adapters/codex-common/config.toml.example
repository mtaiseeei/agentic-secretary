# Optional fallback pointer for repository-local authoring and isolated tests. The formal shared
# distribution uses the Codex plugin manifest and repository marketplace; this file is not required
# for a normal installation. Merge deliberately and never overwrite an existing user config.toml.

[agentic_secretary]
edition = "agentic-secretary"
plugin_root = "<ABSOLUTE_REPOSITORY_PATH>/plugins/secretary"
rules_entrypoint = "<ABSOLUTE_REPOSITORY_PATH>/plugins/secretary/rules/plain-language.md"
